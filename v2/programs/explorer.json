{
  "name": "Explorer",
  "comment": "探索特化型。1 Frameの軽量構成で素早く資源を採取・複製。修理は緊急時のみ。短命だが複製速度で勝負。",
  "components": ["Frame", "Actuator", "Sensor", "Processor", "Harvester", "Assembler", "Charger", "MemoryCore"],
  "rules": [
    {
      "comment": "Energy critically low and near EnergyNode → recharge",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "energy_below", "threshold": 2000 },
          { "op": "nearby", "type": "EnergyNode", "radius": 1 }
        ]
      },
      "action": { "op": "RECHARGE" }
    },
    {
      "comment": "Energy critically low → move toward EnergyNode",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "energy_below", "threshold": 2000 },
          { "op": "nearby", "type": "EnergyNode", "radius": 100 }
        ]
      },
      "action": { "op": "MOVE", "direction": "toward_nearest" }
    },
    {
      "comment": "Durability critical → emergency repair",
      "condition": { "op": "durability_below", "threshold": 40 },
      "action": { "op": "REPAIR" }
    },
    {
      "comment": "Have all components → assemble child immediately",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "inventory_has", "item": "Frame", "count": 1 },
          { "op": "inventory_has", "item": "Actuator", "count": 1 },
          { "op": "inventory_has", "item": "Sensor", "count": 1 },
          { "op": "inventory_has", "item": "Processor", "count": 1 },
          { "op": "inventory_has", "item": "Harvester", "count": 1 },
          { "op": "inventory_has", "item": "Assembler", "count": 1 },
          { "op": "inventory_has", "item": "Charger", "count": 1 },
          { "op": "inventory_has", "item": "MemoryCore", "count": 1 }
        ]
      },
      "action": {
        "op": "ASSEMBLE",
        "components": ["Frame", "Actuator", "Sensor", "Processor", "Harvester", "Assembler", "Charger", "MemoryCore"]
      }
    },
    {
      "comment": "Inactive character nearby → write program",
      "condition": { "op": "nearby", "type": "InactiveCharacter", "radius": 1 },
      "action": { "op": "WRITE", "target": "nearest_inactive" }
    },
    {
      "comment": "Have enough Ore → process to Metal",
      "condition": { "op": "inventory_has", "item": "Ore", "count": 2 },
      "action": { "op": "PROCESS", "recipe": "Metal" }
    },
    {
      "comment": "Have enough Crystal → process to Circuit",
      "condition": { "op": "inventory_has", "item": "Crystal", "count": 2 },
      "action": { "op": "PROCESS", "recipe": "Circuit" }
    },
    {
      "comment": "Have Metal for Frame → craft Frame",
      "condition": { "op": "inventory_has", "item": "Metal", "count": 3 },
      "action": { "op": "CRAFT", "component": "Frame" }
    },
    {
      "comment": "Have Circuit for Processor → craft Processor",
      "condition": { "op": "inventory_has", "item": "Circuit", "count": 3 },
      "action": { "op": "CRAFT", "component": "Processor" }
    },
    {
      "comment": "Have Circuit for Sensor → craft Sensor",
      "condition": { "op": "inventory_has", "item": "Circuit", "count": 2 },
      "action": { "op": "CRAFT", "component": "Sensor" }
    },
    {
      "comment": "Have Metal + Circuit for Actuator → craft Actuator",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "inventory_has", "item": "Metal", "count": 1 },
          { "op": "inventory_has", "item": "Circuit", "count": 1 }
        ]
      },
      "action": { "op": "CRAFT", "component": "Actuator" }
    },
    {
      "comment": "Have Metal for Harvester → craft Harvester",
      "condition": { "op": "inventory_has", "item": "Metal", "count": 2 },
      "action": { "op": "CRAFT", "component": "Harvester" }
    },
    {
      "comment": "Near OreNode → harvest",
      "condition": { "op": "nearby", "type": "OreNode", "radius": 1 },
      "action": { "op": "HARVEST" }
    },
    {
      "comment": "Near CrystalNode → harvest",
      "condition": { "op": "nearby", "type": "CrystalNode", "radius": 1 },
      "action": { "op": "HARVEST" }
    },
    {
      "comment": "Move toward nearest OreNode",
      "condition": { "op": "nearby", "type": "OreNode", "radius": 100 },
      "action": { "op": "MOVE", "direction": "toward_nearest" }
    },
    {
      "comment": "Move toward nearest CrystalNode",
      "condition": { "op": "nearby", "type": "CrystalNode", "radius": 100 },
      "action": { "op": "MOVE", "direction": "toward_nearest" }
    },
    {
      "comment": "Default: do nothing",
      "condition": { "op": "true" },
      "action": { "op": "NOOP" }
    }
  ]
}
