{
  "name": "Scavenger",
  "comment": "死体漁り型。Harvesterを持たず、残骸を分解して資源を得る。EnergyNode付近で待機し、残骸が発生すると接近して分解・複製する。",
  "components": ["Frame", "Actuator", "Sensor", "Processor", "Disassembler", "Assembler", "Charger", "MemoryCore"],
  "rules": [
    {
      "comment": "Recharge when energy low and near EnergyNode",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "energy_below", "threshold": 4000 },
          { "op": "nearby", "type": "EnergyNode", "radius": 1.5 }
        ]
      },
      "action": { "op": "RECHARGE" }
    },
    {
      "comment": "Move toward EnergyNode when energy low",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "energy_below", "threshold": 4000 },
          { "op": "nearby", "type": "EnergyNode", "radius": 100 }
        ]
      },
      "action": { "op": "MOVE", "direction": "toward_nearest", "target": "EnergyNode" }
    },
    {
      "comment": "Repair when durability low",
      "condition": { "op": "durability_below", "threshold": 50 },
      "action": { "op": "REPAIR" }
    },
    {
      "comment": "Assemble when all components ready (Disassembler instead of Harvester)",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "inventory_has", "item": "Frame", "count": 1 },
          { "op": "inventory_has", "item": "Actuator", "count": 1 },
          { "op": "inventory_has", "item": "Sensor", "count": 1 },
          { "op": "inventory_has", "item": "Processor", "count": 1 },
          { "op": "inventory_has", "item": "Disassembler", "count": 1 },
          { "op": "inventory_has", "item": "Assembler", "count": 1 },
          { "op": "inventory_has", "item": "Charger", "count": 1 },
          { "op": "inventory_has", "item": "MemoryCore", "count": 1 }
        ]
      },
      "action": {
        "op": "ASSEMBLE",
        "components": ["Frame", "Actuator", "Sensor", "Processor", "Disassembler", "Assembler", "Charger", "MemoryCore"]
      }
    },
    {
      "comment": "Write to nearby inactive character",
      "condition": { "op": "nearby", "type": "InactiveCharacter", "radius": 1.5 },
      "action": { "op": "WRITE", "target": "nearest_inactive" }
    },
    {
      "comment": "Process Ore to Metal",
      "condition": { "op": "inventory_has", "item": "Ore", "count": 2 },
      "action": { "op": "PROCESS", "recipe": "Metal" }
    },
    {
      "comment": "Process Crystal to Circuit",
      "condition": { "op": "inventory_has", "item": "Crystal", "count": 2 },
      "action": { "op": "PROCESS", "recipe": "Circuit" }
    },
    {
      "comment": "Craft Frame",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "inventory_has", "item": "Metal", "count": 3 },
          { "op": "not", "condition": { "op": "inventory_has", "item": "Frame", "count": 1 } }
        ]
      },
      "action": { "op": "CRAFT", "component": "Frame" }
    },
    {
      "comment": "Craft Processor",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "inventory_has", "item": "Circuit", "count": 3 },
          { "op": "not", "condition": { "op": "inventory_has", "item": "Processor", "count": 1 } }
        ]
      },
      "action": { "op": "CRAFT", "component": "Processor" }
    },
    {
      "comment": "Craft Sensor",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "inventory_has", "item": "Circuit", "count": 2 },
          { "op": "not", "condition": { "op": "inventory_has", "item": "Sensor", "count": 1 } }
        ]
      },
      "action": { "op": "CRAFT", "component": "Sensor" }
    },
    {
      "comment": "Craft MemoryCore",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "inventory_has", "item": "Circuit", "count": 2 },
          { "op": "not", "condition": { "op": "inventory_has", "item": "MemoryCore", "count": 1 } }
        ]
      },
      "action": { "op": "CRAFT", "component": "MemoryCore" }
    },
    {
      "comment": "Craft Disassembler",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "inventory_has", "item": "Metal", "count": 2 },
          { "op": "inventory_has", "item": "Circuit", "count": 1 },
          { "op": "not", "condition": { "op": "inventory_has", "item": "Disassembler", "count": 1 } }
        ]
      },
      "action": { "op": "CRAFT", "component": "Disassembler" }
    },
    {
      "comment": "Craft Charger",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "inventory_has", "item": "Circuit", "count": 2 },
          { "op": "inventory_has", "item": "Metal", "count": 1 },
          { "op": "not", "condition": { "op": "inventory_has", "item": "Charger", "count": 1 } }
        ]
      },
      "action": { "op": "CRAFT", "component": "Charger" }
    },
    {
      "comment": "Craft Assembler",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "inventory_has", "item": "Metal", "count": 2 },
          { "op": "inventory_has", "item": "Circuit", "count": 1 },
          { "op": "not", "condition": { "op": "inventory_has", "item": "Assembler", "count": 1 } }
        ]
      },
      "action": { "op": "CRAFT", "component": "Assembler" }
    },
    {
      "comment": "Craft Actuator",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "inventory_has", "item": "Metal", "count": 1 },
          { "op": "inventory_has", "item": "Circuit", "count": 1 },
          { "op": "not", "condition": { "op": "inventory_has", "item": "Actuator", "count": 1 } }
        ]
      },
      "action": { "op": "CRAFT", "component": "Actuator" }
    },
    {
      "comment": "Near Remains → disassemble",
      "condition": { "op": "nearby", "type": "Remains", "radius": 1.5 },
      "action": { "op": "DISASSEMBLE" }
    },
    {
      "comment": "Remains detected → move toward it",
      "condition": { "op": "nearby", "type": "Remains", "radius": 100 },
      "action": { "op": "MOVE", "direction": "toward_nearest", "target": "Remains" }
    },
    {
      "comment": "Default: recharge if near EnergyNode (wait for corpses)",
      "condition": { "op": "nearby", "type": "EnergyNode", "radius": 1.5 },
      "action": { "op": "RECHARGE" }
    },
    {
      "comment": "Default: move toward EnergyNode to wait",
      "condition": { "op": "nearby", "type": "EnergyNode", "radius": 100 },
      "action": { "op": "MOVE", "direction": "toward_nearest", "target": "EnergyNode" }
    },
    {
      "comment": "Nothing in range — wander based on internal state",
      "condition": { "op": "true" },
      "action": { "op": "MOVE", "direction": "wander" }
    }
  ]
}
