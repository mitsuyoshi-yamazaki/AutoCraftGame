{
  "rules": [
    {
      "comment": "WRITE program to nearby inactive character",
      "condition": { "op": "nearby", "type": "InactiveCharacter", "radius": 1 },
      "action": { "op": "WRITE", "target": "nearest_inactive" }
    },
    {
      "comment": "ASSEMBLE when all components ready",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "inventory_has", "item": "Frame", "count": 1 },
          { "op": "inventory_has", "item": "Actuator", "count": 1 },
          { "op": "inventory_has", "item": "Sensor", "count": 1 },
          { "op": "inventory_has", "item": "Processor", "count": 1 },
          { "op": "inventory_has", "item": "Harvester", "count": 1 },
          { "op": "inventory_has", "item": "Assembler", "count": 1 },
          { "op": "inventory_has", "item": "MemoryCore", "count": 1 }
        ]
      },
      "action": {
        "op": "ASSEMBLE",
        "components": ["Frame", "Actuator", "Sensor", "Processor", "Harvester", "Assembler", "MemoryCore"]
      }
    },
    {
      "comment": "CRAFT MemoryCore",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "not", "condition": { "op": "inventory_has", "item": "MemoryCore", "count": 1 } },
          { "op": "inventory_has", "item": "Circuit", "count": 2 }
        ]
      },
      "action": { "op": "CRAFT", "component": "MemoryCore" }
    },
    {
      "comment": "CRAFT Assembler",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "not", "condition": { "op": "inventory_has", "item": "Assembler", "count": 1 } },
          { "op": "inventory_has", "item": "Metal", "count": 2 },
          { "op": "inventory_has", "item": "Circuit", "count": 1 }
        ]
      },
      "action": { "op": "CRAFT", "component": "Assembler" }
    },
    {
      "comment": "CRAFT Harvester",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "not", "condition": { "op": "inventory_has", "item": "Harvester", "count": 1 } },
          { "op": "inventory_has", "item": "Metal", "count": 2 }
        ]
      },
      "action": { "op": "CRAFT", "component": "Harvester" }
    },
    {
      "comment": "CRAFT Processor",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "not", "condition": { "op": "inventory_has", "item": "Processor", "count": 1 } },
          { "op": "inventory_has", "item": "Circuit", "count": 3 }
        ]
      },
      "action": { "op": "CRAFT", "component": "Processor" }
    },
    {
      "comment": "CRAFT Sensor",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "not", "condition": { "op": "inventory_has", "item": "Sensor", "count": 1 } },
          { "op": "inventory_has", "item": "Circuit", "count": 2 }
        ]
      },
      "action": { "op": "CRAFT", "component": "Sensor" }
    },
    {
      "comment": "CRAFT Actuator",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "not", "condition": { "op": "inventory_has", "item": "Actuator", "count": 1 } },
          { "op": "inventory_has", "item": "Metal", "count": 1 },
          { "op": "inventory_has", "item": "Circuit", "count": 1 }
        ]
      },
      "action": { "op": "CRAFT", "component": "Actuator" }
    },
    {
      "comment": "CRAFT Frame",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "not", "condition": { "op": "inventory_has", "item": "Frame", "count": 1 } },
          { "op": "inventory_has", "item": "Metal", "count": 3 }
        ]
      },
      "action": { "op": "CRAFT", "component": "Frame" }
    },
    {
      "comment": "PROCESS Crystal -> Circuit",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "inventory_has", "item": "Crystal", "count": 2 },
          { "op": "not", "condition": { "op": "inventory_has", "item": "Circuit", "count": 9 } }
        ]
      },
      "action": { "op": "PROCESS", "recipe": "Circuit" }
    },
    {
      "comment": "PROCESS Ore -> Metal",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "inventory_has", "item": "Ore", "count": 2 },
          { "op": "not", "condition": { "op": "inventory_has", "item": "Metal", "count": 8 } }
        ]
      },
      "action": { "op": "PROCESS", "recipe": "Metal" }
    },
    {
      "comment": "HARVEST on Ore node (distance 0)",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "not", "condition": { "op": "inventory_has", "item": "Ore", "count": 16 } },
          { "op": "nearby", "type": "OreNode", "radius": 0 }
        ]
      },
      "action": { "op": "HARVEST" }
    },
    {
      "comment": "HARVEST on Crystal node (distance 0)",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "not", "condition": { "op": "inventory_has", "item": "Crystal", "count": 18 } },
          { "op": "nearby", "type": "CrystalNode", "radius": 0 }
        ]
      },
      "action": { "op": "HARVEST" }
    },
    {
      "comment": "Move toward Ore nodes when needed",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "not", "condition": { "op": "inventory_has", "item": "Ore", "count": 16 } },
          { "op": "nearby", "type": "OreNode", "radius": 100 }
        ]
      },
      "action": { "op": "MOVE", "direction": "toward_nearest" }
    },
    {
      "comment": "Move toward Crystal nodes when needed",
      "condition": {
        "op": "and",
        "conditions": [
          { "op": "not", "condition": { "op": "inventory_has", "item": "Crystal", "count": 18 } },
          { "op": "nearby", "type": "CrystalNode", "radius": 100 }
        ]
      },
      "action": { "op": "MOVE", "direction": "toward_nearest" }
    },
    {
      "comment": "Default: do nothing",
      "condition": { "op": "true" },
      "action": { "op": "NOOP" }
    }
  ]
}
